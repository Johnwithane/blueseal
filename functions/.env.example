# All optional. AI tools use Vertex AI via ADC (no API key) — just enable the
# Vertex AI API on the project once:
#   gcloud services enable aiplatform.googleapis.com --project blueseal-762af
#
# Override the model or region if you want:
# VERTEX_MODEL=gemini-2.5-flash
# VERTEX_LOCATION=us-central1
#
# Stripe is stubbed until you wire it; set these later via
# `firebase functions:secrets:set` and switch the stub to defineSecret.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
