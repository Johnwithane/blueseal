# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Web Push certificate key pair (public key) from Firebase Console →
# Project settings → Cloud Messaging → Web configuration. Leave blank to keep
# web push OFF — the Account toggle stays hidden until this is set.
VITE_FIREBASE_VAPID_KEY=

VITE_USE_EMULATORS=false

VITE_GOOGLE_MAPS_API_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=

# Unsplash image picker. Public Access Key (read-only Search/Download API) from
# https://unsplash.com/oauth/applications. Used client-side to let tradespeople
# pick a banner / portfolio image from Unsplash. Leave blank to hide the
# "Choose from Unsplash" option (uploads still work). Like the Maps key, this
# ships in the browser bundle, so use the Access Key only — never the Secret Key.
VITE_UNSPLASH_ACCESS_KEY=

# Firebase App Check. Leave blank to keep App Check OFF (local dev / preview).
# Set to a reCAPTCHA Enterprise site key to enable client attestation, then set
# ENFORCE_APP_CHECK=true on the Cloud Functions runtime to enforce server-side.
VITE_RECAPTCHA_SITE_KEY=
# Optional fixed debug token for local App Check testing (dev only).
VITE_APPCHECK_DEBUG_TOKEN=

VITE_APP_URL=https://blueseal.app
VITE_APP_NAME=Blue Seal
VITE_DEFAULT_CURRENCY=CAD
VITE_DEFAULT_REGION=CA

# Launch phase (supply-first GTM). "onboarding" (default) keeps the consumer
# marketplace (search, trade + city pages) out of the search index. Set to
# "public" to index the marketplace once the Okanagan supply is stocked.
VITE_LAUNCH_PHASE=onboarding

# Homepage orientation, independent of the launch phase above. Default leads
# clients to "post a job" (client-first hero + prerendered body + title). Set to
# "recruit" to show the tradesperson-recruitment homepage instead — e.g. to run
# a supply-first recruiting push while the marketplace is still held noindex.
VITE_HOMEPAGE_HERO=client

# Insurance partner referral link surfaced in the "Get covered" / "Get insured"
# CTAs (onboarding, dashboard banner, the bid/quote reminder dialog, and the
# uninsured-work waiver). Leave blank to fall back to Foxquilt's public site.
# Replace with the approved tracked partner link once it's issued — no code
# change needed. (Renewal-reminder emails link to the in-app dashboard, where
# this same CTA lives, so they don't need it.)
VITE_INSURANCE_PARTNER_URL=
