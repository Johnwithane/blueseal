# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Web Push certificate key pair (public key) from Firebase Console →
# Project settings → Cloud Messaging → Web configuration. Leave blank to keep
# web push OFF — the Account toggle stays hidden until this is set.
VITE_FIREBASE_VAPID_KEY=

VITE_USE_EMULATORS=false

VITE_GOOGLE_MAPS_API_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=

# Firebase App Check. Leave blank to keep App Check OFF (local dev / preview).
# Set to a reCAPTCHA Enterprise site key to enable client attestation, then set
# ENFORCE_APP_CHECK=true on the Cloud Functions runtime to enforce server-side.
VITE_RECAPTCHA_SITE_KEY=
# Optional fixed debug token for local App Check testing (dev only).
VITE_APPCHECK_DEBUG_TOKEN=

VITE_APP_URL=https://blueseal.app
VITE_APP_NAME=Blue Seal
VITE_DEFAULT_CURRENCY=CAD
VITE_DEFAULT_REGION=CA

# Launch phase (supply-first GTM). "onboarding" (default) recruits tradespeople
# on the homepage and keeps the consumer marketplace (search, trade + city
# pages) out of the search index. Set to "public" to index the marketplace and
# show the client-first homepage once the Okanagan supply is stocked.
VITE_LAUNCH_PHASE=onboarding

# Insurance partner referral link surfaced in the "Get covered" / "Get insured"
# CTAs (onboarding, dashboard banner, the bid/quote reminder dialog, and the
# uninsured-work waiver). Leave blank to fall back to Foxquilt's public site.
# Replace with the approved tracked partner link once it's issued — no code
# change needed. (Renewal-reminder emails link to the in-app dashboard, where
# this same CTA lives, so they don't need it.)
VITE_INSURANCE_PARTNER_URL=
