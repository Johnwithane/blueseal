rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // Multi-role-aware: tokens now carry `roles: string[]`. The legacy `role`
    // string is still accepted so tokens issued before the cutover keep working
    // until the next refresh.
    function hasRole(r) {
      return isSignedIn() && (
        (request.auth.token.roles is list && r in request.auth.token.roles)
        || request.auth.token.role == r
      );
    }
    function isAdmin() { return hasRole('admin'); }
    function isTradie() { return hasRole('tradesperson'); }
    function isClient() { return hasRole('client'); }
    function isOwner(ownerId) { return isSignedIn() && uid() == ownerId; }

    function jobDoc(jobId) { return get(/databases/$(database)/documents/jobs/$(jobId)); }

    // ---------- users ----------
    // Public profile fields (displayName, photoURL) live here. Email/phone/Stripe are
    // private; rules below restrict read to owner + admin. Anyone needing a tradie's
    // public profile data should read /tradespeople/{uid} instead.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Create: caller writes their own doc with role/initial-aggregate fields locked.
      // Field allowlist via hasOnly prevents attacker-planted keys.
      // `roles` array carries the user's identities; `activeRole` is the
      // current view-mode and must be one of the roles in that array. New
      // signups can only self-assign client OR tradesperson — admin is added
      // server-side via setAdminRole. The legacy single-`role` shape is also
      // accepted to keep any in-flight pre-cutover client code working until
      // it gets refreshed.
      allow create: if isOwner(userId)
        && (
          request.resource.data.keys().hasOnly([
            'roles','activeRole','displayName','email','photoURL','phone','bio',
            'createdAt','lastActiveAt','emailVerified',
            'clientRatingAvg','clientRatingCount',
            'termsAcceptedAt','termsAcceptedVersion',
            'deletedAt','notificationPrefs'
          ])
          || request.resource.data.keys().hasOnly([
            'role','displayName','email','photoURL','phone','bio',
            'createdAt','lastActiveAt','emailVerified',
            'clientRatingAvg','clientRatingCount',
            'termsAcceptedAt','termsAcceptedVersion',
            'deletedAt','notificationPrefs'
          ])
        )
        && (
          // New shape
          (request.resource.data.roles is list
            && request.resource.data.roles.size() == 1
            && request.resource.data.roles[0] in ['client', 'tradesperson']
            && request.resource.data.activeRole == request.resource.data.roles[0])
          ||
          // Legacy shape (single role string)
          (!('roles' in request.resource.data)
            && request.resource.data.role in ['client', 'tradesperson'])
        )
        && request.resource.data.clientRatingAvg == 0
        && request.resource.data.clientRatingCount == 0
        && request.resource.data.emailVerified == false
        && request.resource.data.termsAcceptedVersion is string;

      // Update: positive field-level equality checks (deletion-safe vs hasAny diff).
      // `roles` is server-managed (add via addRoleToSelf callable) — the user
      // cannot grant themselves a new role from the client. `activeRole` can
      // change freely as long as it stays inside `roles`. Legacy single-`role`
      // docs (pre-multi-role cutover) are tolerated so existing accounts can
      // still edit their profile until they're back-filled.
      //
      // Field-equality checks use `.get(field, null)` so legacy docs that
      // pre-date a later-added field don't trip the rule evaluator. Without
      // the default, `resource.data.foo` on a missing field throws
      // "Property foo is undefined" and Firestore reports it to the client
      // as permission-denied — locking accounts created before the field
      // existed (e.g. before `deletedAt`, `termsAcceptedAt`,
      // `termsAcceptedVersion`, the `clientRating*` aggregates) out of every
      // self-edit including display name + photo. With `.get(..., null)`,
      // missing-on-both-sides compares equal so the doc keeps editing; any
      // attempt to *add* one of these server-managed fields still mismatches
      // and fails the rule. Same pattern is documented inline on
      // /tradespeople for payouts / paidJobsCount / paidLifetimeCents.
      allow update: if isOwner(userId)
        && (
          // New shape. `activeRole` defaults to the first role when missing
          // so a partially-migrated doc (has `roles` but no `activeRole`)
          // still lets the owner edit their profile — the default is always
          // in `roles` so the `in` check passes.
          (resource.data.roles is list
            && request.resource.data.roles == resource.data.roles
            && request.resource.data.get('activeRole', resource.data.roles[0]) in resource.data.roles)
          ||
          // Legacy shape — role field is immutable, no roles/activeRole yet.
          (!('roles' in resource.data)
            && request.resource.data.role == resource.data.role)
        )
        && request.resource.data.get('email', null) == resource.data.get('email', null)
        && request.resource.data.get('clientRatingAvg', null) == resource.data.get('clientRatingAvg', null)
        && request.resource.data.get('clientRatingCount', null) == resource.data.get('clientRatingCount', null)
        && request.resource.data.get('emailVerified', null) == resource.data.get('emailVerified', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('termsAcceptedAt', null) == resource.data.get('termsAcceptedAt', null)
        && request.resource.data.get('termsAcceptedVersion', null) == resource.data.get('termsAcceptedVersion', null)
        // deletedAt is server-managed via the requestAccountDeletion callable
        // (admin SDK bypasses rules). Owner cannot grant themselves a
        // deletion or un-do one — keeps the path deliberate and auditable.
        && request.resource.data.get('deletedAt', null) == resource.data.get('deletedAt', null);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- tradespeople (public profile, owner-editable while vetting) ----------
    match /tradespeople/{tradieId} {
      // Public read only when visible. Owner + admin always read.
      // NOTE: exposing under-review (pending/info_requested) profiles publicly
      // is deferred — the public doc still carries vettingNotes + payouts, and
      // Firestore reads are all-or-nothing, so opening this would leak admin
      // notes + Stripe state. Move those fields to a private subdoc first (see
      // QA_SECURITY_AUDIT.md), then re-open this read.
      allow read: if (resource != null && resource.data.isVisible == true)
                  || isOwner(tradieId) || isAdmin();
      allow create: if isOwner(tradieId)
        && request.resource.data.vettingStatus == 'draft'
        && request.resource.data.isVisible == false
        && request.resource.data.verifiedTrades.size() == 0
        && request.resource.data.idVerified == false
        && request.resource.data.ratingAvg == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.nextInvoiceNumber == 1;
      // Owner update: positive equality checks on server-managed fields,
      // and approved tradies can't yank themselves back into vetting.
      // The insurance/WSIB flags are set by Cloud Function triggers in
      // response to admin review of the verification docs — owner cannot
      // grant themselves these badges.
      allow update: if isOwner(tradieId)
        && request.resource.data.verifiedTrades == resource.data.verifiedTrades
        && request.resource.data.idVerified == resource.data.idVerified
        && request.resource.data.insuranceVerified == resource.data.insuranceVerified
        && request.resource.data.insuranceExpiresAt == resource.data.insuranceExpiresAt
        && request.resource.data.wsibVerified == resource.data.wsibVerified
        && request.resource.data.wsibExpiresAt == resource.data.wsibExpiresAt
        && request.resource.data.isVisible == resource.data.isVisible
        && request.resource.data.ratingAvg == resource.data.ratingAvg
        && request.resource.data.ratingCount == resource.data.ratingCount
        && request.resource.data.ratingDimensions == resource.data.ratingDimensions
        && request.resource.data.nextInvoiceNumber == resource.data.nextInvoiceNumber
        // Invoice/quote numbering customisation (prefixes + the lazily-
        // added quote counter) is server-managed via the
        // `setInvoiceNumbering` callable — owner can't rewrite the
        // prefix or skip the sequence from the client. `.get(field, null)`
        // is required because all three are optional on legacy docs that
        // pre-date the customisation feature; without the default the
        // rule evaluator throws and locks out every existing tradie.
        && request.resource.data.get('invoicePrefix', null)
             == resource.data.get('invoicePrefix', null)
        && request.resource.data.get('quotePrefix', null)
             == resource.data.get('quotePrefix', null)
        && request.resource.data.get('nextQuoteNumber', null)
             == resource.data.get('nextQuoteNumber', null)
        && request.resource.data.approvedAt == resource.data.approvedAt
        // Stripe Connect state + verified-earnings stats are server-managed
        // (webhook dispatcher + payment_intent.succeeded handler). Use
        // `.get(field, null)` for safe access — `resource.data.foo` throws
        // "Property foo is undefined" on legacy docs that pre-date the
        // monetization-pivot schema, which would otherwise lock out every
        // existing tradesperson from editing their profile. With the
        // default, missing-on-both-sides compares equal, owner writes that
        // touch the field don't.
        && request.resource.data.get('payouts', null)
             == resource.data.get('payouts', null)
        && request.resource.data.get('paidJobsCount', null)
             == resource.data.get('paidJobsCount', null)
        && request.resource.data.get('paidLifetimeCents', null)
             == resource.data.get('paidLifetimeCents', null)
        // Google Business reviews snapshot is server-managed (written only by
        // the google/* Cloud Functions). Owner can't forge or clear it from
        // the client. `.get(field, null)` for safe access on docs predating it.
        && request.resource.data.get('googleReviews', null)
             == resource.data.get('googleReviews', null)
        && (resource.data.vettingStatus == 'approved'
            ? request.resource.data.vettingStatus == 'approved'
            : request.resource.data.vettingStatus in ['draft','pending','info_requested']);
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // ---------- tradespeople/{uid}/private/{docId} ----------
      // Exact service-area location + (often home) address + billing contact
      // details. NEVER world-readable — that's the whole reason they're split
      // off the public tradesperson doc. Owner + admin only. The owner writes
      // these via setLocation / setContactInfo; admin can read for vetting +
      // support and correct if needed.
      match /private/{docId} {
        allow read: if isOwner(tradieId) || isAdmin();
        allow write: if isOwner(tradieId) || isAdmin();
      }

      // ---------- tradespeople/{uid}/secure/{docId} ----------
      // Server-only credentials — currently the encrypted Google Business
      // refresh token + connected-location ids (secure/google). Unlike the
      // owner-readable /private subdoc, NOTHING client-side may read or write
      // here: even the owner shouldn't be able to pull their own (encrypted)
      // OAuth token out to the browser. The google/* Cloud Functions reach it
      // via the Admin SDK, which bypasses these rules.
      match /secure/{docId} {
        allow read, write: if false;
      }
    }

    // ---------- certifications ----------
    match /certifications/{certId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.tradespersonId == uid());
      allow create: if isTradie()
        && request.resource.data.tradespersonId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.rejectionReason == null;
      // Owner can replace pending cert; admin can approve/reject
      allow update: if (isOwner(resource.data.tradespersonId)
                       && resource.data.status == 'pending'
                       && request.resource.data.status == 'pending'
                       && request.resource.data.tradespersonId == resource.data.tradespersonId
                       && request.resource.data.reviewedBy == resource.data.reviewedBy
                       && request.resource.data.reviewedAt == resource.data.reviewedAt)
                    || isAdmin();
      // Owner can withdraw a still-pending submission (e.g. wrong file, wrong
      // trade) so they can re-upload without admin intervention. Approved /
      // rejected certs are immutable from the owner side — admin only.
      allow delete: if (isOwner(resource.data.tradespersonId)
                       && resource.data.status == 'pending')
                    || isAdmin();
    }

    // ---------- idVerifications (admin-only read; never world-readable) ----------
    match /idVerifications/{tradieId} {
      allow read: if isAdmin() || isOwner(tradieId);
      allow create: if isTradie() && isOwner(tradieId)
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null;
      allow update: if (isOwner(tradieId)
                       && resource.data.status == 'pending'
                       && request.resource.data.status == 'pending'
                       && request.resource.data.reviewedBy == resource.data.reviewedBy
                       && request.resource.data.reviewedAt == resource.data.reviewedAt)
                    || isAdmin();
      // Owner can withdraw a still-pending ID so they can re-upload (e.g. wrong
      // document, bad photo). Once approved/rejected the doc is admin-only.
      allow delete: if (isOwner(tradieId) && resource.data.status == 'pending')
                    || isAdmin();
    }

    // ---------- insuranceVerifications (general-liability proof) ----------
    // Owner + admin read; owner may upload/replace while pending; admin
    // writes review decisions. Status flip → onInsuranceApproved trigger
    // mirrors the badge onto the public tradesperson doc.
    match /insuranceVerifications/{tradieId} {
      allow read: if isAdmin() || isOwner(tradieId);
      allow create: if isTradie() && isOwner(tradieId)
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null;
      allow update: if (isOwner(tradieId)
                       && resource.data.status == 'pending'
                       && request.resource.data.status == 'pending'
                       && request.resource.data.reviewedBy == resource.data.reviewedBy
                       && request.resource.data.reviewedAt == resource.data.reviewedAt)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- wsibVerifications (provincial workers'-comp clearance) ----------
    // Same shape as insuranceVerifications. Clearance certs typically
    // expire every 60–90 days; the public badge auto-hides once expiresAt
    // passes (frontend filter) but the doc itself stays for audit.
    match /wsibVerifications/{tradieId} {
      allow read: if isAdmin() || isOwner(tradieId);
      allow create: if isTradie() && isOwner(tradieId)
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null;
      allow update: if (isOwner(tradieId)
                       && resource.data.status == 'pending'
                       && request.resource.data.status == 'pending'
                       && request.resource.data.reviewedBy == resource.data.reviewedBy
                       && request.resource.data.reviewedAt == resource.data.reviewedAt)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- intake form schemas (public read, admin write) ----------
    match /intakeFormSchemas/{trade} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- jobs ----------
    match /jobs/{jobId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == uid()
        || resource.data.tradespersonId == uid()
        || isAdmin()
      );
      allow create: if isClient()
        && request.resource.data.clientId == uid()
        && request.resource.data.status == 'requested'
        && request.resource.data.tradespersonId is string;
      // Updates: identity + creation fields immutable. Status transitions are
      // permitted but the doc cannot be reassigned to a different client/tradie/chat.
      // Counterparty display fields (denormalized at create) are also immutable
      // so a party can't tamper with the name/avatar shown to the other side.
      allow update: if isSignedIn()
        && (resource.data.clientId == uid()
            || resource.data.tradespersonId == uid()
            || isAdmin())
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.tradespersonId == resource.data.tradespersonId
        && request.resource.data.chatId == resource.data.chatId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.trade == resource.data.trade
        && request.resource.data.get('clientName', null)
            == resource.data.get('clientName', null)
        && request.resource.data.get('clientPhotoURL', null)
            == resource.data.get('clientPhotoURL', null)
        && request.resource.data.get('tradespersonName', null)
            == resource.data.get('tradespersonName', null)
        && request.resource.data.get('tradespersonPhotoURL', null)
            == resource.data.get('tradespersonPhotoURL', null)
        // privateNotes moved to the jobs/{jobId}/private/notes subdoc (client
        // can read the job doc, so the notes can't live on it). See the
        // `private` match block below.
        // Per-party archive: each party may set/clear only their own
        // archive timestamp. Admin can touch either. `.get(field, null)`
        // is required because the fields are optional and pre-existing
        // jobs predate them — without the default, the rule evaluator
        // throws "Property foo is undefined" on legacy docs and locks
        // every update out.
        && (
          resource.data.clientId == uid()
          || isAdmin()
          || request.resource.data.get('clientArchivedAt', null)
              == resource.data.get('clientArchivedAt', null)
        )
        && (
          resource.data.tradespersonId == uid()
          || isAdmin()
          || request.resource.data.get('tradespersonArchivedAt', null)
              == resource.data.get('tradespersonArchivedAt', null)
        )
        // pendingChange + statusBeforeHold are server-managed: only the
        // request/respond/withdraw/resume callables (admin SDK, which bypasses
        // rules) may write them. A party writing them directly would let the
        // client fake/self-accept a cancel-or-hold request. `.get(field, null)`
        // defaults so legacy docs (no field) don't lock every update out.
        && (isAdmin()
            || request.resource.data.get('pendingChange', null)
                == resource.data.get('pendingChange', null))
        && (isAdmin()
            || request.resource.data.get('statusBeforeHold', null)
                == resource.data.get('statusBeforeHold', null))
        // Direct (non-admin) status writes are limited to the two pre-commitment
        // client paths: marketplace intake advance (accepted→requested) and the
        // instant pre-commitment cancel (cancelJob, only from accepted/requested/
        // quoted). Everything money- or acceptance-gated — cancelling a committed
        // job, going on_hold, resuming — must go through the callables. This is
        // the rules-side enforcement of "the tradesperson must accept once work
        // is committed" and mirrors the QA_SECURITY_AUDIT.md status-table note.
        && (
          isAdmin()
          || request.resource.data.status == resource.data.status
          || (resource.data.status == 'accepted'
              && request.resource.data.status == 'requested')
          || (request.resource.data.status == 'cancelled'
              && resource.data.status in ['accepted', 'requested', 'quoted'])
        );
      allow delete: if isAdmin();

      // ---------- jobs/{jobId}/timeEntries (clock-in sessions) ----------
      // Tradie writes; the client + tradie + admin can read (the client
      // sees a live timer + session log so the eventual invoice is
      // unsurprising). Uniqueness of "one running entry per tradie per
      // job" is enforced transactionally by the clockIn callable — rules
      // can't enforce uniqueness across docs. The denormalised
      // tradespersonId/clientId on the row let rules avoid an extra
      // parent-job lookup on every read.
      match /timeEntries/{entryId} {
        // Authorize via the PARENT job, not the row's denormalized ids. The
        // client's listener filters by tradespersonId (to skip stale entries
        // from a swapped tradie), so a per-doc `resource.data.clientId == uid()`
        // predicate can never authorize the client's LIST ("rules are not
        // filters"). The parent lookup is resource-independent, so a list from
        // EITHER party is authorized. Matches the jobs/private + expenses rules.
        function isJobParty() {
          return isSignedIn() && (
            jobDoc(jobId).data.tradespersonId == uid()
            || jobDoc(jobId).data.clientId == uid()
          );
        }
        allow read: if isJobParty() || isAdmin();
        // Create allowed for the assigned tradie; identity + parent-job
        // ids must match the parent job. invoicedAt locked null on create
        // so a freshly-clocked entry can't claim it's already billed.
        allow create: if isTradie()
          && request.resource.data.tradespersonId == uid()
          && request.resource.data.tradespersonId == jobDoc(jobId).data.tradespersonId
          && request.resource.data.clientId == jobDoc(jobId).data.clientId
          && request.resource.data.invoicedAt == null
          && request.resource.data.source in ['clock', 'manual']
          && request.resource.data.hourlyRateSnapshot is int
          && request.resource.data.hourlyRateSnapshot >= 0;
        // Update: tradie can edit notes + end an open entry. Identity,
        // startedAt, rate snapshot, source, invoicedAt are all locked.
        // Admin may correct anything.
        allow update: if (isOwner(resource.data.tradespersonId)
                         && request.resource.data.tradespersonId == resource.data.tradespersonId
                         && request.resource.data.clientId == resource.data.clientId
                         && request.resource.data.startedAt == resource.data.startedAt
                         && request.resource.data.hourlyRateSnapshot == resource.data.hourlyRateSnapshot
                         && request.resource.data.source == resource.data.source
                         && request.resource.data.invoicedAt == resource.data.invoicedAt)
                      || isAdmin();
        // Tradie can delete only their own, only while not yet invoiced.
        allow delete: if (isOwner(resource.data.tradespersonId)
                         && resource.data.invoicedAt == null)
                      || isAdmin();
      }

      // ---------- jobs/{jobId}/private/{docId} (tradie-only notes) ----------
      // Holds the tradesperson's private job log (free-text notes + the
      // AI auto-log). The parent job doc is client-readable, so these can't
      // live on it. Gated to the assigned tradie + admin via a parent-job
      // lookup. The client can read the job but NOT this subdoc.
      match /private/{docId} {
        allow read: if isSignedIn()
          && (jobDoc(jobId).data.tradespersonId == uid() || isAdmin());
        allow create, update: if isSignedIn()
          && (jobDoc(jobId).data.tradespersonId == uid() || isAdmin())
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 20000;
        allow delete: if isAdmin();
      }

      // ---------- jobs/{jobId}/expenses (tradie-only; client never reads) ----------
      // Cost-basis + supplier names are private to the tradie. The client
      // only ever sees the resulting line item once the tradie pulls the
      // expense into an invoice. Receipt files in Storage are restricted
      // the same way (see storage.rules).
      match /expenses/{expenseId} {
        allow read: if isSignedIn()
          && (resource.data.tradespersonId == uid() || isAdmin());
        allow create: if isTradie()
          && request.resource.data.tradespersonId == uid()
          && request.resource.data.tradespersonId == jobDoc(jobId).data.tradespersonId
          && request.resource.data.clientId == jobDoc(jobId).data.clientId
          && request.resource.data.invoicedAt == null
          && request.resource.data.status in ['parsing', 'ready']
          && request.resource.data.totalCost is int
          && request.resource.data.totalCost >= 0
          && request.resource.data.billedAmount is int
          && request.resource.data.billedAmount >= 0
          && request.resource.data.markupPercent is number
          && request.resource.data.markupPercent >= 0
          && request.resource.data.markupPercent <= 1000;
        allow update: if (isOwner(resource.data.tradespersonId)
                         && request.resource.data.tradespersonId == resource.data.tradespersonId
                         && request.resource.data.clientId == resource.data.clientId
                         && request.resource.data.receiptStoragePath == resource.data.receiptStoragePath
                         && request.resource.data.createdAt == resource.data.createdAt
                         && request.resource.data.invoicedAt == resource.data.invoicedAt)
                      || isAdmin();
        allow delete: if (isOwner(resource.data.tradespersonId)
                         && resource.data.invoicedAt == null)
                      || isAdmin();
      }
    }

    // ---------- jobPosts (job-board marketplace) ----------
    // Top-level doc holds only non-sensitive fields. Exact address,
    // applicationCount, and selectedApplicantId live in /private/meta
    // so the bid-blind + address-privacy contracts are enforced by rules,
    // not by client-side stripping. All writes flow through callables.
    match /jobPosts/{postId} {
      function postOpen() { return resource.data.status == 'open'; }
      function isPostOwner() { return isSignedIn() && resource.data.clientId == uid(); }
      // Ownership by PARENT-post lookup, for nested subcollections whose own
      // docs don't carry clientId (private/meta) or that get LISTed unfiltered
      // (applications). isPostOwner() reads `resource.data.clientId`, which is
      // the post doc only at the parent level — inside a subcollection match
      // `resource` is the child doc, so this resolves ownership off the post.
      function isPostOwnerByLookup() {
        return isSignedIn()
          && get(/databases/$(database)/documents/jobPosts/$(postId)).data.clientId == uid();
      }
      function isVisibleTradie() {
        return isTradie()
          && exists(/databases/$(database)/documents/tradespeople/$(uid()))
          && get(/databases/$(database)/documents/tradespeople/$(uid())).data.isVisible == true;
      }

      allow read:   if isPostOwner() || isAdmin() || (isVisibleTradie() && postOpen());
      allow create: if false;  // createJobPost callable only
      allow update: if false;  // marketplace callables only
      allow delete: if isAdmin();

      match /private/{docId} {
        allow read:  if isPostOwnerByLookup() || isAdmin();
        allow write: if false;
      }

      match /applications/{tradieId} {
        // Bid-blind: post-owning client OR the applicant themselves OR admin.
        // CollectionGroup queries auto-filter via the same predicate — a tradie
        // querying applications where tradespersonId == uid gets only their own.
        //
        // `resource == null` short-circuit: the tradie's JobPostDetailView
        // subscribes to applications/{theirUid} on mount, BEFORE they've
        // applied. Without the null guard the rule evaluator throws on
        // `resource.data.tradespersonId` and Firestore reports
        // permission-denied — turning "no application yet" into an
        // uncaught snapshot-listener error in the console. Same pattern
        // /quotes and /invoices already use. We gate the missing-doc read
        // on `tradieId == uid()` so it can only be used to probe one's
        // own slot, not to enumerate other tradies' application IDs.
        allow read: if isAdmin()
          || (resource == null && isSignedIn() && tradieId == uid())
          || (resource != null && resource.data.tradespersonId == uid())
          // Post owner — by parent lookup so the client's UNFILTERED applicant
          // list (subscribeApplicationsForPost) is authorized. A per-doc
          // `resource.data.clientId == uid()` only covers single-doc gets, not
          // the list ("rules are not filters"), which broke the client's
          // Applicants view for every non-admin client.
          || isPostOwnerByLookup();
        allow create, update, delete: if false;  // marketplace callables only
      }
    }

    // ---------- applications (collection group: the tradesperson's "Applied" tab) ----------
    // subscribeMyApplications runs collectionGroup('applications') filtered by
    // tradespersonId == uid. Collection-group queries are NOT authorized by the
    // nested /jobPosts/{postId}/applications rule above — that one only covers
    // direct + per-post reads. They need this recursive-wildcard rule, scoped to
    // the applicant's own docs (+ admin) so a tradie can't enumerate other
    // tradies' bids: the query filters tradespersonId == uid and the rule
    // enforces the same predicate. Writes stay callable-only (admin SDK).
    match /{path=**}/applications/{tradieId} {
      allow read: if isAdmin()
        || (resource != null && resource.data.tradespersonId == uid());
      allow write: if false;
    }

    // ---------- notifications (per-user inbox; writes via Cloud Function) ----------
    // Owner can only flip read/readAt (mark-as-read). Every other field is
    // pinned to its prior value so a compromised client can't rewrite a
    // notification's content, link, or routing context.
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow update: if isSignedIn()
        && resource.data.userId == uid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.link == resource.data.link
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.jobId == resource.data.jobId
        && request.resource.data.chatId == resource.data.chatId
        && request.resource.data.actorUid == resource.data.actorUid
        // .get(..., null) handles legacy docs that pre-date the field —
        // both sides resolve to null so the equality check holds.
        && request.resource.data.get('recipientRole', null) == resource.data.get('recipientRole', null)
        && request.resource.data.get('actorPhotoURL', null) == resource.data.get('actorPhotoURL', null)
        && request.resource.data.get('actorDisplayName', null) == resource.data.get('actorDisplayName', null);
      allow create, delete: if false;
    }

    // ---------- rateLimits (server-only) ----------
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // ---------- chats ----------
    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == uid()
        || resource.data.tradespersonId == uid()
        || isAdmin()
      );
      // Identity fields locked post-create so a party can't boot the other side.
      allow update: if isSignedIn()
        && (resource.data.clientId == uid()
            || resource.data.tradespersonId == uid()
            || isAdmin())
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.tradespersonId == resource.data.tradespersonId
        && request.resource.data.jobId == resource.data.jobId;
      allow create: if isSignedIn()
        && (request.resource.data.clientId == uid()
            || request.resource.data.tradespersonId == uid());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == uid()
          || get(/databases/$(database)/documents/chats/$(chatId)).data.tradespersonId == uid()
          || isAdmin()
        );
        allow create: if isSignedIn()
          && request.resource.data.senderId == uid()
          && request.resource.data.type in ['text', 'photo']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          // Denormalized sender info — string (capped) or null. Users can't
          // read each other's user docs, so the recipient relies on these
          // to render the avatar + name without a cross-account lookup.
          && (request.resource.data.senderName == null
              || (request.resource.data.senderName is string
                  && request.resource.data.senderName.size() <= 80))
          && (request.resource.data.senderPhotoURL == null
              || (request.resource.data.senderPhotoURL is string
                  && request.resource.data.senderPhotoURL.size() <= 1024))
          && (
            get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == uid()
            || get(/databases/$(database)/documents/chats/$(chatId)).data.tradespersonId == uid()
          );
        // Messages are immutable for legal accountability
        allow update, delete: if isAdmin();
      }
    }

    // ---------- public reviews (client -> tradie) ----------
    // AirBnB-style mutual-blind reveal: the subject (tradesperson) cannot
    // see a review until BOTH sides have submitted, or the 14-day window
    // expires. `revealedAt` is the gate — null = hidden, Timestamp = live.
    // Author (client) always sees their own; admin sees everything.
    // Pre-cutover reviews may not carry the field — `.get('revealedAt', null)`
    // treats them as hidden to the counterparty by default; backfill before
    // launch if any of them need to be public retroactively.
    match /reviews/{reviewId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.clientId == uid())  // author always
        || (resource.data.get('revealedAt', null) != null && (
             resource.data.status == 'active'                  // world (active only)
             || (isSignedIn() && resource.data.tradespersonId == uid())
           ));
      // Create still bound to the job parties + active status. New: revealedAt
      // must be null on create (reveal is server-only), and the pair must not
      // already be locked (deadline passed = no more submissions).
      allow create: if isClient()
        && request.resource.data.clientId == uid()
        && request.resource.data.status == 'active'
        && request.resource.data.get('revealedAt', null) == null
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId))
        && jobDoc(request.resource.data.jobId).data.clientId == uid()
        && jobDoc(request.resource.data.jobId).data.tradespersonId == request.resource.data.tradespersonId
        && jobDoc(request.resource.data.jobId).data.status in ['complete', 'reviewed']
        && (
          // Pair may not exist yet (e.g. pre-cutover job, or the seeder
          // raced) — allow either. If it does exist, it must not be locked.
          !exists(/databases/$(database)/documents/reviewPairs/$(request.resource.data.jobId))
          || get(/databases/$(database)/documents/reviewPairs/$(request.resource.data.jobId)).data.locked == false
        );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- private client reviews (tradie -> client) ----------
    // Same reveal contract as /reviews but inverted: author is the
    // tradesperson; subject is the client.
    match /clientReviews/{reviewId} {
      allow read: if isAdmin()
        || (isTradie() && resource.data.tradespersonId == uid())  // author always
        || (resource.data.get('revealedAt', null) != null
            && isSignedIn() && resource.data.clientId == uid());   // subject after reveal
      allow create: if isTradie()
        && request.resource.data.tradespersonId == uid()
        && request.resource.data.get('revealedAt', null) == null
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId))
        && jobDoc(request.resource.data.jobId).data.tradespersonId == uid()
        && jobDoc(request.resource.data.jobId).data.clientId == request.resource.data.clientId
        && jobDoc(request.resource.data.jobId).data.status in ['complete', 'reviewed']
        && (
          !exists(/databases/$(database)/documents/reviewPairs/$(request.resource.data.jobId))
          || get(/databases/$(database)/documents/reviewPairs/$(request.resource.data.jobId)).data.locked == false
        );
      allow update, delete: if isAdmin();
    }

    // ---------- review pairs (mutual-review state machine; server-only writes) ----------
    // One doc per completed job (id == jobId, same deterministic pattern as
    // invoices). Created server-side by ensureReviewPair (called from
    // markJobPaid + clientMarkPaid). Holds the 14-day deadline, who has
    // submitted, the reveal timestamp, and the nudge bookkeeping. Parties +
    // admin read; nobody writes from the client — every state transition
    // (submission, reveal, lock) flows through the Cloud Functions side.
    match /reviewPairs/{jobId} {
      // `resource == null` short-circuit: JobDetailView subscribes to
      // reviewPairs/{jobId} long before the pair is created (the doc only
      // appears once a side marks paid via ensureReviewPair). Without the
      // null guard the rule evaluator throws on `resource.data.clientId`
      // and Firestore reports permission-denied — spamming the console
      // with a retrying snapshot-listener error for every open job. Gate
      // the missing-doc read on the requester being a party to the
      // parent job so we don't leak whether arbitrary job ids exist.
      allow read: if isAdmin()
        || (resource != null && isSignedIn() && (
             resource.data.clientId == uid()
             || resource.data.tradespersonId == uid()
           ))
        || (resource == null && isSignedIn()
             && exists(/databases/$(database)/documents/jobs/$(jobId))
             && (jobDoc(jobId).data.clientId == uid()
                 || jobDoc(jobId).data.tradespersonId == uid()));
      allow create, update, delete: if false;
    }

    // ---------- bookings ----------
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.tradespersonId == uid() || isAdmin()
      );
      allow create: if isTradie()
        && request.resource.data.tradespersonId == uid();
      allow update: if isTradie()
        && resource.data.tradespersonId == uid()
        && request.resource.data.tradespersonId == resource.data.tradespersonId;
      allow delete: if isTradie() && resource.data.tradespersonId == uid();
    }

    // ---------- quotes ----------
    // Tradesperson-authored estimates. Shape + flow mirrors invoices —
    // deterministic id == jobId, creates flow through the submitQuote
    // callable (admin SDK bypass), tradesperson edits their own draft via
    // updateQuoteLineItems / updateQuoteDiscount, client can only flip
    // sent → viewed for the read-receipt signal.
    match /quotes/{quoteId} {
      // resource == null short-circuit: quotes are keyed by jobId (same
      // pattern as invoices) so the client probes quotes/{jobId} and
      // treats missing as "no quote yet". Without the null guard the
      // rule evaluator throws on resource.data.X and Firestore reports
      // permission-denied — masking "no quote" as "access denied".
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.clientId == uid()
        || resource.data.tradespersonId == uid()
        || isAdmin()
      );
      // Creates always via submitQuote (admin SDK bypasses rules).
      allow create: if false;
      // Tradesperson can edit their own quote (line items, discount, terms,
      // etc.) — identity fields locked. Status transitions to accepted /
      // declined / sent (re-send) go through callables, but a tradesperson
      // could still flip status via direct write; we don't block that here
      // because the canonical paths (callables) are unaffected and rule
      // exhaustiveness on every field would balloon. resource.data.status
      // != 'accepted' freezes the quote once accepted.
      allow update: if isSignedIn()
        && resource.data.tradespersonId == uid()
        && request.resource.data.quoteNumber == resource.data.quoteNumber
        && request.resource.data.tradespersonId == resource.data.tradespersonId
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.jobId == resource.data.jobId
        && resource.data.status != 'accepted';
      // Client may flip sent → viewed for the read-receipt signal — all
      // money + identity fields pinned to their prior value so the client
      // can't rewrite the quote contents.
      allow update: if isSignedIn()
        && resource.data.clientId == uid()
        && resource.data.status == 'sent'
        && request.resource.data.status == 'viewed'
        && request.resource.data.tradespersonId == resource.data.tradespersonId
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.jobId == resource.data.jobId
        && request.resource.data.quoteNumber == resource.data.quoteNumber
        && request.resource.data.lineItems == resource.data.lineItems
        && request.resource.data.subtotal == resource.data.subtotal
        && request.resource.data.discount == resource.data.discount
        && request.resource.data.discountAmount == resource.data.discountAmount
        && request.resource.data.total == resource.data.total;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- invoices ----------
    match /invoices/{invoiceId} {
      // resource == null short-circuit: invoices are keyed deterministically
      // by jobId (onJobCompleted creates them), so the natural client flow
      // is to attempt invoices/{jobId} for any open job and treat missing
      // as "no invoice yet". Without the null guard the rule evaluator
      // throws on resource.data.clientId and Firestore reports that to the
      // client as permission-denied — making "no invoice yet" indistinguishable
      // from "access denied" and breaking JobDetailView for valid parties.
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.clientId == uid()
        || resource.data.tradespersonId == uid()
        || isAdmin()
      );
      // Tradies can draft invoices for jobs they were assigned to. The number
      // and identity fields are immutable post-create. Status transitions to
      // "sent"/"paid" go through the Cloud Function path.
      allow create: if isTradie()
        && request.resource.data.tradespersonId == uid()
        && request.resource.data.status == 'draft'
        && request.resource.data.paidAt == null;
      allow update: if isSignedIn()
        && resource.data.tradespersonId == uid()
        && request.resource.data.invoiceNumber == resource.data.invoiceNumber
        && request.resource.data.tradespersonId == resource.data.tradespersonId
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.jobId == resource.data.jobId
        // Stripe payment state is server-managed (sendInvoice callable +
        // webhook dispatcher). Owner can't tamper with the PaymentIntent
        // / refunds / dispute mirror. `.get(field, null)` is needed for
        // safe access on pre-cutover invoices where `payment` is absent —
        // without the default, `resource.data.payment` throws "Property
        // payment is undefined" and blocks every legacy update.
        && request.resource.data.get('payment', null)
             == resource.data.get('payment', null)
        // Once the invoice enters any server-managed lifecycle state —
        // processing (PaymentIntent in flight), paid, refunded / partially
        // refunded, disputed, or void — the owner can't mutate it. The
        // webhook dispatcher (admin SDK, bypasses rules) is the only path
        // that transitions through these states. Pre-cutover invoices
        // continue to support manual "mark paid" via the legacy paid path
        // until the cutover commit removes that.
        && !(resource.data.status in [
          'processing', 'paid', 'refunded', 'partially_refunded',
          'disputed', 'void'
        ]);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- disputes (Stripe chargeback / inquiry mirror; server-only writes) ----------
    // Doc id == Stripe `dp_…` dispute id. Written by the
    // `charge.dispute.created|closed` handlers in the webhook dispatcher.
    // Admin reads across all disputes (for the queue); the tradesperson +
    // client on the underlying invoice read their own. No client writes —
    // evidence submission happens in the Stripe Dashboard.
    match /disputes/{disputeId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.tradespersonId == uid())
        || (isSignedIn() && resource.data.clientId == uid());
      allow create, update, delete: if false;
    }

    // ---------- supportTickets (Help Center contact form) ----------
    // A signed-in user files a ticket from the Help Center; admins triage it
    // from /admin/support. Signed-out visitors use the email (mailto) fallback,
    // so this collection never takes unauthenticated writes. Create is locked
    // to the exact shape (status starts 'open', timestamps == request.time,
    // userId == the caller, no admin-only fields set). Admins own everything
    // after that; an admin update may only touch status / updatedAt / handledBy.
    match /supportTickets/{ticketId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['userId', 'name', 'email', 'topic', 'message', 'status', 'handledBy', 'createdAt', 'updatedAt'])
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'open'
        && request.resource.data.handledBy == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 2000;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'handledBy']);
      allow delete: if isAdmin();
    }

    // ---------- payouts (Stripe Connect payout ledger; server-only writes) ----------
    // Doc id == Stripe `po_…` payout id; created/updated by the webhook
    // dispatcher in response to `payout.created|paid|failed` events. The
    // tradesperson subscribes to their own payouts for the in-app Payouts
    // view; admins can read across tradies. No client-side writes — the
    // dispatcher uses the Admin SDK which bypasses rules.
    match /payouts/{payoutId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.tradespersonId == uid());
      allow create, update, delete: if false;
    }

    // ---------- webhookEvents (Stripe webhook idempotency sentinel; server-only) ----------
    // Doc id == Stripe `evt_…` event id. Dispatcher creates the sentinel
    // before doing any side-effect work, so retried deliveries become
    // no-ops. Never readable from the client — internal infra.
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // ---------- ai usage (write via Cloud Function; admin/owner read) ----------
    match /aiUsage/{usageId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow create, update, delete: if false;
    }

    // ---------- assistantConversations (per-user AI chatbot threads) ----------
    // Owner reads conversation metadata + messages directly so the panel can
    // subscribe in real-time. Writes route through the `aiChat` callable
    // (admin SDK bypasses rules) so the user turn + assistant reply persist
    // together — clients never write a half-conversation. Owner can delete
    // a conversation to clear that thread's history.
    match /assistantConversations/{conversationId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow read: if isAdmin();
      allow create, update: if false;
      allow delete: if (isSignedIn() && resource.data.userId == uid()) || isAdmin();

      // Messages — server-only writes, owner reads. Note the parent-doc
      // get() costs one read per message-list page; acceptable here because
      // these threads are short (HISTORY_TURNS=16 working window + tail).
      match /messages/{messageId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/assistantConversations/$(conversationId)).data.userId == uid();
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    // ---------- audit log (write via Cloud Function; admin read only) ----------
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ---------- mail (Firebase Trigger Email extension; server-only) ----------
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // ---------- sms (Firebase Twilio SMS extension; server-only) ----------
    // Currently dormant — notify() uses WhatsApp for high-priority fan-out.
    // Kept in rules + code so the channel can be re-enabled via a future
    // preferences UI without re-introducing the schema.
    match /sms/{smsId} {
      allow read, write: if false;
    }

    // ---------- whatsapp (Meta Cloud API queue; server-only) ----------
    // Default high-priority channel. Processor lives in
    // functions/src/messaging/processWhatsAppMessage.ts and reads/writes
    // status fields on these docs.
    match /whatsapp/{messageId} {
      allow read, write: if false;
    }

    // ---------- canonical static data (trades list, etc.) ----------
    match /catalog/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- vouches (peer endorsements between tradespeople) ----------
    // All writes flow through the vouch callables (sendVouchRequest /
    // acceptVouch / declineVouch / revokeVouch + the signup linker
    // trigger) so denormalised display fields stay consistent and dupe
    // checks (one vouch per from→to pair) happen transactionally.
    //
    // Reads:
    //   accepted    → world-readable so any profile viewer can render the
    //                 "Vouched for by" / "Tradespeople I work with" chips.
    //   declined    → parties + admin only (no public proof of a refusal).
    //   pending_*   → parties + admin only.
    // toEmail is only present while status == pending_signup and is gated
    // behind party-only read by the rule above, so the invited email never
    // leaks publicly.
    match /vouches/{vouchId} {
      allow read: if resource.data.status == 'accepted'
                  || isAdmin()
                  || (isSignedIn() && (
                       resource.data.fromUserId == uid()
                       || resource.data.toUserId == uid()
                     ));
      allow create, update, delete: if false;
    }

    // ---------- prospects (seeded, unclaimed tradesperson listings) ----------
    // Seeded from public registries + reviewed research. NOT members: separate
    // collection from tradespeople/ so they can never satisfy the
    // isVisible==true (vetted) invariant. Public read ONLY when isListed (so
    // search can surface them with a "Pending verification" badge); a suppressed
    // (isListed=false) prospect is admin-only. Writes flow through admin
    // callables (bulkImportProspects / suppressProspect) on the Admin SDK, which
    // bypasses rules; client-side writes are limited to admins. The harvested
    // email/phone are NOT on this doc — only emailHash + the private subdoc.
    match /prospects/{prospectId} {
      allow read: if (resource != null && resource.data.isListed == true) || isAdmin();
      allow create, update, delete: if isAdmin();

      // prospects/{id}/private/contact — plaintext harvested email/phone.
      // Never world-readable (that's why it's split off). Admin only; the
      // import + outreach callables read/write it via the Admin SDK.
      match /private/{docId} {
        allow read, write: if isAdmin();
      }
    }

    // ---------- prospectLeads (a real client request held against a prospect) ----------
    // Created by requestProspectOutreach, drained into a real job by
    // claimProspect. The owning client can read their own lead to see
    // status; nobody else (the prospect has no account yet). All writes flow
    // through callables/triggers on the Admin SDK.
    match /prospectLeads/{leadId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.clientId == uid());
      allow create, update, delete: if false;
    }

    // ---------- prospectSuppression (permanent opt-out / takedown tombstones) ----------
    // Must never leak who opted out, so it's admin-read only and written solely
    // server-side (suppressProspect endpoint + admin takedown, both Admin SDK).
    match /prospectSuppression/{suppressionKey} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ---------- siteContent (admin-editable public site copy) ----------
    // World-readable so the home page can render testimonials etc. without
    // requiring auth. Admin-only write — adding new editable content blocks
    // means adding fields to an existing doc here, or a new doc per page.
    match /siteContent/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- rebatePrograms (admin-curated public reference data) ----------
    // Government/utility rebate & grant programs surfaced (read-only) to clients
    // in the post-a-job flow. World-readable reference data; only admins curate
    // it. See src/data/rebatePrograms.ts and AdminRebateProgramsView.vue.
    match /rebatePrograms/{programId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
