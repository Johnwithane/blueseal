# Happy-path E2E harness credentials — copy to `e2e/.env.local` and fill in.
# `e2e/.env.local` is gitignored; NEVER commit real credentials.
#
# These two accounts must already exist on the target project:
#   - the client account holds only the `client` role
#   - the tradesperson account holds `tradesperson` + `admin` + `qa`
#     (admin/qa let it self-provision + approve vetting via /qa during a run)

# Target site (defaults to the deployed test-mode site if unset).
QA_BASE_URL=https://blueseal-762af.web.app

# Client account (role: client)
QA_CLIENT_EMAIL=clientqa@blueseal.app
QA_CLIENT_PASSWORD=replace-me

# Tradesperson account (roles: tradesperson + admin + qa)
QA_TRADIE_EMAIL=tradieqa@blueseal.app
QA_TRADIE_PASSWORD=replace-me
